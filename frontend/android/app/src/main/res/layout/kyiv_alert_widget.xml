<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@drawable/widget_bg_normal"
    android:padding="8dp">

    <!-- Left: Radar Snapshot -->
    <ImageView
        android:id="@+id/widget_radar_image"
        android:layout_width="105dp"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:background="@drawable/widget_radar_placeholder"
        android:contentDescription="@string/widget_name" />

    <!-- Right: Threat Status & Details -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="8dp"
        android:gravity="center_vertical">

        <!-- Top Header: Status + Target Count + Updated Time -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/widget_status_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="БЕЗПЕЧНО"
                android:textColor="#4CAF50"
                android:textSize="12sp"
                android:textStyle="bold"
                android:singleLine="true" />

            <TextView
                android:id="@+id/widget_threat_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="• 0 цілей"
                android:textColor="#FFA726"
                android:textSize="11sp"
                android:textStyle="bold"
                android:layout_marginStart="4dp"
                android:visibility="gone"
                android:singleLine="true" />

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/widget_updated_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="--:--"
                android:textColor="#888888"
                android:textSize="10sp"
                android:singleLine="true" />
        </LinearLayout>

        <!-- Distance & ETA to User Location -->
        <TextView
            android:id="@+id/widget_nearest_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Немає загроз поблизу"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold"
            android:maxLines="2"
            android:ellipsize="end"
            android:layout_marginTop="3dp" />

        <!-- Last Telegram Message Snippet -->
        <TextView
            android:id="@+id/widget_last_msg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#AAAAAA"
            android:textSize="10sp"
            android:maxLines="2"
            android:ellipsize="end"
            android:visibility="gone"
            android:layout_marginTop="2dp" />

        <!-- Subtle Footer Branding -->
        <TextView
            android:id="@+id/widget_brand"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Kyiv Alert Monitor 🇺🇦"
            android:textColor="#666677"
            android:textSize="9sp"
            android:layout_marginTop="2dp"
            android:singleLine="true" />

    </LinearLayout>

</LinearLayout>
